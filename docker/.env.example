# Copy to docker/.env and edit. (docker/.env is read by `docker compose -f docker/compose.yaml ...`; never commit it.)
# Guide: docs/install-docker.md

# --- The site -------------------------------------------------------------------------------------------------------
# The domain name that points at this machine. Needed for a real HTTPS certificate. Ports 80 and 443 must reach it.
# Empty = a self-signed test certificate (browsers warn). A public IPv4 address works too.
IL2KS_HTTPS_DOMAIN=stats.example.com
# Optional: the certificate authority writes here if renewal ever fails.
IL2KS_HTTPS_EMAIL=

# --- The game server ------------------------------------------------------------------------------------------------
# REQUIRED. DServer names its log files in the local time zone of the game machine: an IANA name such as Europe/Berlin,
# America/New_York or Asia/Seoul (UTC if the machine runs on UTC).
IL2KS_SERVER_TIMEZONE=UTC

# REQUIRED. DServer's folder with the text mission logs (missionReport(...)[0].txt), as seen from this Linux host.
# Under Wine it is inside the Wine prefix, for example:
#   /home/you/.wine/drive_c/Program Files/IL-2 Sturmovik Great Battles/data/Multiplayer/Cooperative/Logs
# (find yours with: find ~/.wine -name 'missionReport*' | head). Use the real path, no ~ and no quotes.
IL2KS_LOGS_HOST_DIR=/home/you/.wine/drive_c/path/to/logs

# Read-only mount (default): il2ks never changes DServer's files, and leaves them where they are ("keep").
# To let il2ks tidy the game's folder instead, set IL2KS_LOGS_READ_ONLY=false and IL2KS_LOGS_AFTER_ARCHIVE=move
# (originals go to the data volume, ingested-logs/) or delete. Then the container user must be allowed to write there.
IL2KS_LOGS_READ_ONLY=true
IL2KS_LOGS_AFTER_ARCHIVE=keep
# Linux user the container runs as (`id -u` and `id -g` on the host). Only matters if the logs are not world-readable,
# or if you make the mount writable.
IL2KS_CONTAINER_UID=1000
IL2KS_CONTAINER_GID=1000

# Optional: fix the server ID (a UUID) instead of letting il2ks generate and remember one.
IL2KS_SERVER_UID=

# --- First start: the admin account ---------------------------------------------------------------------------------
# Created at start while no admin exists yet; changing it later changes nothing. Leave both empty to create it yourself:
#   docker compose -f docker/compose.yaml exec il2ks il2ks createadmin
# Pick a strong password; delete it from this file afterwards if you like (the account stays).
IL2KS_ADMIN_USERNAME=admin
IL2KS_ADMIN_PASSWORD=
